# ==============================================================================
# Agentic Policy Data Analytics Platform - Environment Configuration
# Copy this file to .env (or backend/.env and frontend/.env.local) and adjust values
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. App Settings
# ------------------------------------------------------------------------------
# Runtime environment mode: 'development', 'staging', or 'production'
ENVIRONMENT=development

# Application name displayed in API docs and OpenAPI schema
PROJECT_NAME="Agentic Policy Data Analytics Platform"

# Secret key used for cryptographic signing and session tokens (min 32 characters)
SECRET_KEY=change-this-to-a-secure-random-string-in-production

# Logging verbosity level: 'DEBUG', 'INFO', 'WARNING', 'ERROR', or 'CRITICAL'
LOG_LEVEL=INFO

# JSON-encoded array or comma-separated list of allowed CORS origins: '["http://localhost:3000"]'
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# FastAPI REST API v1 route prefix path string: '/api/v1'
API_V1_STR=/api/v1

# ------------------------------------------------------------------------------
# 2. Database (Postgres)
# ------------------------------------------------------------------------------
# PostgreSQL async connection URL format: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+asyncpg://policy_user:policy_pass@localhost:5432/policy_analytics

# ------------------------------------------------------------------------------
# 3. Redis
# ------------------------------------------------------------------------------
# Redis connection URL string for caching and pub/sub: redis://<host>:<port>/<db>
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 4. LLM Providers (OpenAI, Anthropic, Gemini, Bedrock, Mock mode)
# ------------------------------------------------------------------------------
# Boolean flag to enable offline deterministic mock LLM responses: 'true' or 'false'
MOCK_LLM=false

# Primary LLM provider identifier: 'bedrock', 'gemini', 'openai', or 'anthropic'
PRIMARY_LLM_PROVIDER=bedrock

# Fallback LLM provider identifier when primary is unavailable: 'gemini', 'bedrock', 'openai', or 'anthropic'
FALLBACK_LLM_PROVIDER=gemini

# Boolean flag to enable fallback LLM execution when primary fails: 'true' or 'false' (default: false)
# If false, errors from the primary provider are raised immediately and fallback provider is NOT called
LLM_FALLBACK=false

# Global default timeout in seconds for LLM provider requests: float or integer (default: 30)
LLM_TIMEOUT_SECONDS=30

# Google Gemini API key: secret string obtained from Google AI Studio
GEMINI_API_KEY=

# Google Gemini model identifier string: e.g. 'gemini-3.5-flash-lite' or 'gemini-1.5-flash'
GEMINI_MODEL=gemini-3.5-flash-lite

# Google Gemini request timeout in seconds (default: 30)
GEMINI_TIMEOUT_SECONDS=30

# Amazon Bedrock API key / auth bearer token (if using token-based access)
BEDROCK_API_KEY=

# Amazon Bedrock bearer token override (optional alternative to AWS IAM keys)
AWS_BEARER_TOKEN_BEDROCK=

# AWS IAM access key ID for Bedrock client authentication: e.g. 'AKIAIOSFODNN7EXAMPLE'
AWS_ACCESS_KEY_ID=

# AWS IAM secret access key for Bedrock client authentication: e.g. 'wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY'
AWS_SECRET_ACCESS_KEY=

# AWS region hosting Amazon Bedrock foundation models: e.g. 'ap-south-1', 'us-east-1'
AWS_REGION=ap-south-1

# Default AWS region fallback: e.g. 'ap-south-1', 'us-east-1'
AWS_DEFAULT_REGION=ap-south-1

# Amazon Bedrock foundation model ID string: e.g. 'apac.amazon.nova-lite-v1:0'
BEDROCK_MODEL_ID=apac.amazon.nova-lite-v1:0

# Amazon Bedrock request timeout in seconds (default: 30)
BEDROCK_TIMEOUT_SECONDS=30

# OpenAI API key for OpenAI model fallback: secret string 'sk-...'
OPENAI_API_KEY=

# Anthropic Claude API key for direct Claude API fallback: secret string 'sk-ant-...'
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 5. Data Sources (SingStat, Data.gov.sg, Mock data)
# ------------------------------------------------------------------------------
# Boolean flag to use local fixture data instead of live remote APIs: 'true' or 'false'
USE_MOCK_DATA_SOURCES=false

# Boolean flag to allow falling back to mock data when live remote APIs fail: 'true' or 'false' (default: false)
USE_MOCK_DATA_AS_FALLBACK=false

# Boolean flag to enable SingStat Model Context Protocol (MCP) server integration: 'true' or 'false'
SINGSTAT_MCP_ENABLED=true

# HTTP endpoint URL for SingStat MCP server: 'https://...'
SINGSTAT_MCP_URL=https://chatwithsandra.singstat.gov.sg/mcp

# SingStat developer API subscription key: secret string
SINGSTAT_API_KEY=

# Data.gov.sg developer API token for querying CKAN and v2 data APIs: secret string
DATAGOV_API_TOKEN=

# ------------------------------------------------------------------------------
# 6. Frontend Settings (frontend/.env.local)
# ------------------------------------------------------------------------------
# Backend REST API base URL accessible by frontend browser client: 'http://localhost:8000'
NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend WebSocket base URL for live streaming agent events: 'ws://localhost:8000'
NEXT_PUBLIC_WS_URL=ws://localhost:8000
